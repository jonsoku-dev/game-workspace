{
  "schema_version": 1,
  "engine": "web",
  "work_id": "web-92f78113a6254bcaa8382191aae6c096",
  "title": "잿불 골목",
  "genre": "belt-scrolling dungeon brawler",
  "goal": "감독관을 쓰러뜨린 뒤 사슬 승강장으로 계속 진행하여 방패 수문장과 증기 구역을 돌파한다.",
  "controls": "방향키/WASD 이동·깊이 회피, J 3연격, K 올려치기, Space 회피와 간파 반격. 방패는 뒤쪽에서 때리거나 K로 개방. Enter 문/던전 계속, P 일시정지, R 첫 던전부터. 패배 시 현재 던전 재도전. 모바일 방향패드·전투 버튼.",
  "stages": [
    {
      "id": "ember-alley",
      "title": "잿불 골목",
      "objective": "두 구역을 해방하고 쇠사슬 감독관을 쓰러뜨린다.",
      "tactic": "붉은 예고를 깊이축으로 피하고, 간파 반격과 공중 연격으로 감독관의 가드를 끊는다."
    },
    {
      "id": "chain-lift",
      "title": "사슬 승강장",
      "objective": "증기 승강장을 지나 방패 수문장을 모두 쓰러뜨린다.",
      "tactic": "예고된 증기 구역에서 벗어나 방패의 뒤로 돌아가거나 K 올려치기로 개방한다. 정면 연타는 방패에 막힌다."
    }
  ],
