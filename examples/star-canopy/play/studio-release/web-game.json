{
  "schema_version": 1,
  "engine": "web",
  "work_id": "web-03da65a001e64cafb3f5bd83cbf573ee",
  "title": "별잎 고원",
  "genre": "횡스크롤 플랫폼 액션 RPG",
  "goal": "별잎 고원에서 얻은 별꽃을 간직하고 달빛 상층숲의 두 봉화를 높이·방향·맥동에 맞춰 밝혀 두 숲의 별길을 잇는다.",
  "controls": "←/→ 또는 A/D 이동, Space 점프, ↓/S 발판 내려가기, ↑/W 상승기류·문. J 근접 별가지, K 방향성 별꽃 발사(레벨 2). 별꽃은 바라보는 방향과 높이로 날아가 첫 대상에 명중한다. P 쉬기, R 첫 구역부터 다시. 터치 버튼 지원. 완료 화면에서 다음 구역, 패배 화면에서 현재 구역 재도전.",
  "stages": [
    {
      "id": "starleaf-meadow",
      "title": "별잎 고원",
      "objective": "별잎 세 장과 바람꽃을 되찾아 고원의 문을 연다.",
      "tactic": "두 마리 처치로 별꽃 개방 · 같은 높이에서 바람꽃에 발사."
    },
    {
      "id": "moonlit-grove",
      "title": "달빛 상층숲",
      "objective": "아래·위 봉화를 순서대로 밝히고 별길의 문에 도착한다.",
      "tactic": "아래 발판에서 오른쪽으로 첫 봉화 → 열린 바람길 ↑ → 위 발판 오른편에서 왼쪽으로, 둘째 봉화가 밝을 때 별꽃을 맞힌다."
    }
  ],
