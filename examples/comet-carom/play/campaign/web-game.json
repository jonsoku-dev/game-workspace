{
  "schema_version": 1,
  "engine": "web",
  "work_id": "web-b3c275fa35d14d02a01639d588014ec1",
  "title": "혜성 궤도",
  "genre": "turn-based slingshot ricochet RPG",
  "goal": "월식의 방벽을 무너뜨린 뒤 쌍성 관측소의 두 고리를 한 발로 이어 관측핵을 해방한다.",
  "controls": "수호자 또는 1·2·3 선택. 뒤로 당겼다 놓아 발사. ←→ 각도, ↑↓ 위력, Space 발사. 슬라이더·발사 버튼 지원. 조준선은 첫 적·벽 충돌과 반사를 예측한다. 충전 후 S 필살기, 실패 시 현재 단계 재도전 버튼. R 캠페인 처음부터.",
  "stages": [
    {
      "id": "sanctum",
      "title": "월식의 성소",
      "objective": "잔영과 월식의 심장을 격파해 관측소로 향한다.",
      "tactic": "금빛 약점은 턴마다 회전한다. 벽 반사·동료 연계로 방어를 관통한다."
    },
    {
      "id": "twin-observatory",
      "title": "쌍성 관측소",
      "objective": "같은 발사로 두 고리를 켠 뒤 열린 관측핵을 격파한다.",
      "tactic": "벽이나 동료를 먼저 거친 한 발로 두 고리를 잇는다. 핵은 다음 발사까지 열린다. 루나의 가로 반사를 활용한다."
    }
  ],
